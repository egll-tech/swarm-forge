#!/bin/zsh
set -euo pipefail

default_repo_url="https://github.com/egll-tech/swarm-forge"
pack_names=(two-pack four-pack six-pack)
known_clis=(claude codex copilot grok)

usage() {
  echo "usage: get-swarm-forge <two-pack|four-pack|six-pack|project-manager|lieutenant> [--cli <claude|codex|copilot|grok>]" >&2
  echo "  Packs (two-pack, four-pack, six-pack) compose into the current directory." >&2
  echo "  project-manager and lieutenant are forges (projects/, dashboard, host lieutenant)." >&2
  echo "  --cli writes that agent CLI onto the lieutenant and every pack role." >&2
  echo "  With no --cli, a terminal asks which CLI to use. Press Enter to keep each template's CLI." >&2
  echo "  With no terminal, pass --cli or pipe one CLI name. Otherwise each template's CLI is kept." >&2
}

product=""
cli_arg=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --cli)
      if [[ $# -lt 2 || "$2" == -* ]]; then
        echo "get-swarm-forge: --cli requires a CLI name" >&2
        usage
        exit 1
      fi
      cli_arg="$2"
      shift 2
      ;;
    --cli=*)
      cli_arg="${1#--cli=}"
      if [[ -z "$cli_arg" ]]; then
        echo "get-swarm-forge: --cli requires a CLI name" >&2
        usage
        exit 1
      fi
      shift
      ;;
    -*)
      echo "get-swarm-forge: unknown option '$1'" >&2
      usage
      exit 1
      ;;
    *)
      if [[ -n "$product" ]]; then
        echo "get-swarm-forge: unexpected argument '$1'" >&2
        usage
        exit 1
      fi
      product="$1"
      shift
      ;;
  esac
done

if [[ -z "$product" ]]; then
  echo "get-swarm-forge: missing product" >&2
  usage
  exit 1
fi

case "$product" in
  two-pack|four-pack|six-pack|project-manager|lieutenant) ;;
  *)
    echo "get-swarm-forge: unknown product '$product'" >&2
    usage
    exit 1
    ;;
esac

repo_url="${SWARMFORGE_REPO_URL:-$default_repo_url}"
tmp_dir="$(mktemp -d)"

cleanup() {
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

local_git_dir() {
  if [[ -v SWARMFORGE_GIT_DIR ]]; then
    echo "$SWARMFORGE_GIT_DIR"
  elif [[ -d "$HOME/projects/swarm-forge/.git" ]]; then
    echo "$HOME/projects/swarm-forge"
  fi
}

try_download_branch() {
  local ref="$1"
  local dest="$2"
  local url="${repo_url}/archive/refs/heads/${ref}.tar.gz"
  local tar_path="$tmp_dir/${ref}.tgz"
  local git_dir
  mkdir -p "$dest"
  if curl -fsSL "$url" -o "$tar_path"; then
    tar -xz --strip-components=1 -C "$dest" -f "$tar_path"
    return 0
  fi
  git_dir="$(local_git_dir)"
  if [[ -n "$git_dir" && -d "$git_dir/.git" ]] \
       && git -C "$git_dir" show-ref --verify --quiet "refs/heads/$ref"; then
    echo "get-swarm-forge: GitHub has no branch '$ref'; using $git_dir" >&2
    git -C "$git_dir" archive --format=tar "$ref" | tar -x -C "$dest"
    return 0
  fi
  return 1
}

download_branch() {
  local ref="$1"
  local dest="$2"
  if try_download_branch "$ref" "$dest"; then
    return
  fi
  echo "get-swarm-forge: branch '$ref' was not found at ${repo_url}/archive/refs/heads/${ref}.tar.gz" >&2
  echo "Push the branch, or set SWARMFORGE_GIT_DIR to a local checkout that has it." >&2
  exit 1
}

fail_missing() {
  local missing_path="$1"
  echo "get-swarm-forge: missing required file after composing swarm: $missing_path" >&2
  exit 1
}

trim_choice() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

# Sets selected_cli, or clears it and marks an explicit keep.
# Returns 1 when the token is not a CLI, a menu number, or keep.
accept_cli_choice() {
  local choice keep_index
  choice="$(trim_choice "$1")"
  choice="${(L)choice}"
  keep_index=$(( ${#known_clis[@]} + 1 ))
  case "$choice" in
    ""|keep)
      selected_cli=""
      cli_explicit_keep=1
      return 0
      ;;
  esac
  if [[ "$choice" == <-> ]]; then
    if (( choice >= 1 && choice <= ${#known_clis[@]} )); then
      selected_cli="${known_clis[$choice]}"
      return 0
    elif (( choice == keep_index )); then
      selected_cli=""
      cli_explicit_keep=1
      return 0
    fi
    return 1
  fi
  case "$choice" in
    claude|codex|copilot|grok)
      selected_cli="$choice"
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

reject_unknown_cli() {
  echo "get-swarm-forge: unknown CLI '$1'" >&2
  echo "Choose claude, codex, copilot, grok, or keep." >&2
  exit 1
}

prompt_cli() {
  local choice name keep_index i
  cli_prompted=1
  keep_index=$(( ${#known_clis[@]} + 1 ))
  echo "Which agent CLI should this install use for the lieutenant and every pack role?" >&2
  i=1
  for name in "${known_clis[@]}"; do
    echo "  $i) $name" >&2
    i=$((i + 1))
  done
  echo "  ${keep_index}) keep the CLI already on each template line" >&2
  echo "Choosing a CLI writes it onto the lieutenant and every pack role." >&2
  echo "Press Enter to keep each template line. The lieutenant then defaults to grok." >&2
  while true; do
    printf "Choice [keep]: " >&2
    if ! IFS= read -r choice; then
      echo >&2
      selected_cli=""
      cli_explicit_keep=1
      return 0
    fi
    if accept_cli_choice "$choice"; then
      return 0
    fi
    echo "get-swarm-forge: choose claude, codex, copilot, grok, or keep." >&2
  done
}

choose_cli() {
  local piped
  selected_cli=""
  cli_explicit_keep=0
  cli_prompted=0
  if [[ -n "${cli_arg:-}" ]]; then
    if ! accept_cli_choice "$cli_arg"; then
      reject_unknown_cli "$cli_arg"
    fi
  elif [[ -n "${SWARMFORGE_CLI:-}" ]]; then
    if ! accept_cli_choice "$SWARMFORGE_CLI"; then
      reject_unknown_cli "$SWARMFORGE_CLI"
    fi
  elif [[ -t 0 && -t 1 ]]; then
    prompt_cli
  elif IFS= read -r piped; then
    if ! accept_cli_choice "$piped"; then
      reject_unknown_cli "$piped"
    fi
  fi
  if [[ -n "${selected_cli:-}" ]]; then
    echo "get-swarm-forge: using ${selected_cli}." >&2
  elif [[ "${cli_explicit_keep:-}" == "1" || "${cli_prompted:-}" == "1" ]]; then
    echo "get-swarm-forge: keeping each template's CLI." >&2
  else
    echo "get-swarm-forge: no CLI selected; keeping each template's CLI. Pass --cli <claude|codex|copilot|grok> to choose one." >&2
  fi
}

apply_cli_to_window_conf() {
  local conf="$1"
  local cli="$2"
  local tmp
  [[ -f "$conf" ]] || return 0
  tmp="$tmp_dir/cli-window-conf"
  awk -v cli="$cli" '
    $1 == "window" || $1 == "window-invisible" {
      if (NF >= 4) $3 = cli
      print
      next
    }
    { print }
  ' "$conf" > "$tmp"
  mv "$tmp" "$conf"
}

apply_cli_to_host_conf() {
  local conf="$1"
  local cli="$2"
  local tmp last
  mkdir -p "${conf:h}"
  if [[ ! -f "$conf" ]]; then
    printf 'Lieutenant %s\n' "$cli" > "$conf"
    return 0
  fi
  tmp="$tmp_dir/cli-host-conf"
  awk -v cli="$cli" '
    tolower($1) == "lieutenant" {
      if (NF < 2) print "Lieutenant " cli
      else { $2 = cli; print }
      next
    }
    { print }
  ' "$conf" > "$tmp"
  mv "$tmp" "$conf"
  if ! grep -Eiq '^[[:space:]]*lieutenant[[:space:]]+' "$conf"; then
    if [[ -s "$conf" ]]; then
      last="$(tail -c 1 "$conf" || true)"
      if [[ "$last" != $'\n' ]]; then
        printf '\n' >> "$conf"
      fi
    fi
    printf 'Lieutenant %s\n' "$cli" >> "$conf"
  fi
}

apply_selected_cli() {
  local pack_name
  [[ -n "${selected_cli:-}" ]] || return 0
  case "$product" in
    project-manager|lieutenant)
      apply_cli_to_host_conf "swarmforge/swarmforge.conf" "$selected_cli"
      if [[ "$product" == "lieutenant" ]]; then
        apply_cli_to_window_conf ".swarmforge/project-pack/swarmforge/swarmforge.conf" "$selected_cli"
      else
        for pack_name in "${pack_names[@]}"; do
          apply_cli_to_window_conf "packs/${pack_name}/swarmforge/swarmforge.conf" "$selected_cli"
        done
      fi
      ;;
    *)
      apply_cli_to_window_conf "swarmforge/swarmforge.conf" "$selected_cli"
      ;;
  esac
}

installed_message() {
  local kind="$1"
  local from="$2"
  local next_step="$3"
  if [[ -n "${selected_cli:-}" ]]; then
    echo "SwarmForge $kind installed from $from using $selected_cli. $next_step"
  else
    echo "SwarmForge $kind installed from $from. $next_step"
  fi
}

copy_shared_scripts_and_articles() {
  local src="$1"
  [[ -d "$src/swarmforge/scripts" ]] || fail_missing "swarmforge/scripts from $src"
  [[ -d "$src/swarmforge/constitution/articles" ]] || fail_missing "swarmforge/constitution/articles from $src"
  mkdir -p swarmforge/constitution/articles
  rm -rf swarmforge/scripts
  cp -R "$src/swarmforge/scripts" swarmforge/scripts
  local shared_article
  for shared_article in engineering.prompt workflow.prompt handoffs.prompt; do
    [[ -f "$src/swarmforge/constitution/articles/$shared_article" ]] \
      && cp "$src/swarmforge/constitution/articles/$shared_article" \
           "swarmforge/constitution/articles/$shared_article"
  done
}

copy_host_files() {
  local src="$1"
  copy_shared_scripts_and_articles "$src"
  [[ -f "$src/swarmforge/constitution.prompt" ]] \
    && cp "$src/swarmforge/constitution.prompt" swarmforge/constitution.prompt
  mkdir -p swarmforge/roles
  [[ -f "$src/swarmforge/roles/lieutenant.prompt" ]] \
    && cp "$src/swarmforge/roles/lieutenant.prompt" swarmforge/roles/lieutenant.prompt
  if [[ ! -f swarmforge/swarmforge.conf && -f "$src/swarmforge/swarmforge.conf" ]]; then
    cp "$src/swarmforge/swarmforge.conf" swarmforge/swarmforge.conf
  fi
  if [[ -f "$src/swarm" ]]; then
    cp "$src/swarm" swarm
  elif [[ ! -f swarm ]]; then
    cat > swarm <<'WRAP'
#!/bin/zsh
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$SCRIPT_DIR/swarmforge/scripts/swarmforge.sh" "$@"
WRAP
  fi
  chmod +x swarm
}

copy_pack_template() {
  local src="$1"
  local dest="$2"
  mkdir -p "$dest/swarmforge"
  [[ -f "$src/swarm" ]] && cp "$src/swarm" "$dest/swarm"
  [[ -f "$src/swarmforge/swarmforge.conf" ]] || fail_missing "swarmforge/swarmforge.conf in pack"
  [[ -d "$src/swarmforge/roles" ]] || fail_missing "swarmforge/roles in pack"
  cp "$src/swarmforge/swarmforge.conf" "$dest/swarmforge/swarmforge.conf"
  [[ -f "$src/swarmforge/constitution.prompt" ]] \
    && cp "$src/swarmforge/constitution.prompt" "$dest/swarmforge/constitution.prompt"
  rm -rf "$dest/swarmforge/roles"
  cp -R "$src/swarmforge/roles" "$dest/swarmforge/roles"
  mkdir -p "$dest/swarmforge/constitution/articles"
  if [[ -d "$src/swarmforge/constitution/articles" ]]; then
    for pack_article in "$src/swarmforge/constitution/articles"/*; do
      [[ -f "$pack_article" ]] || continue
      article_name="${pack_article:t}"
      case "$article_name" in
        engineering.prompt|workflow.prompt|handoffs.prompt) continue ;;
      esac
      cp "$pack_article" "$dest/swarmforge/constitution/articles/$article_name"
    done
  fi
}

verify_pack_roles() {
  local dest="$1"
  [[ -f "$dest/swarmforge/swarmforge.conf" ]] || fail_missing "$dest/swarmforge/swarmforge.conf"
  while IFS= read -r role; do
    [[ -f "$dest/swarmforge/roles/${role}.prompt" ]] \
      || fail_missing "$dest/swarmforge/roles/${role}.prompt"
  done < <(awk '/^window/ { print $2 }' "$dest/swarmforge/swarmforge.conf")
}

pack_tree() {
  local name="$1"
  if [[ -n "$packs_src" && -d "$packs_src/$name" ]]; then
    echo "$packs_src/$name"
  elif [[ -n "$packs_src" && -f "$packs_src/swarmforge/swarmforge.conf" ]]; then
    echo "$packs_src"
  else
    echo ""
  fi
}

install_project_pack() {
  local pack_src
  pack_src="$(pack_tree "$product")"
  if [[ -z "$pack_src" && -d "$host_dir/.swarmforge/project-pack" ]]; then
    pack_src="$host_dir/.swarmforge/project-pack"
  fi
  [[ -n "$pack_src" && -d "$pack_src" ]] || fail_missing ".swarmforge/project-pack"
  mkdir -p .swarmforge/project-pack
  copy_pack_template "$pack_src" ".swarmforge/project-pack"
  verify_pack_roles ".swarmforge/project-pack"
}

install_named_packs() {
  mkdir -p packs
  local pack_name pack_src
  for pack_name in "${pack_names[@]}"; do
    pack_src="$(pack_tree "$pack_name")"
    if [[ -z "$pack_src" ]]; then
      pack_src="$tmp_dir/packs/$pack_name"
      download_branch "$pack_name" "$pack_src"
    fi
    [[ -n "$pack_src" && -d "$pack_src" ]] || fail_missing "pack $pack_name"
    copy_pack_template "$pack_src" "packs/$pack_name"
    verify_pack_roles "packs/$pack_name"
  done
}

require_files() {
  local required_path
  for required_path in "$@"; do
    [[ -e "$required_path" ]] || fail_missing "$required_path"
  done
}

host_dir="${SWARMFORGE_BASE_DIR:-$tmp_dir/host}"
host_from="$product"
packs_src="${SWARMFORGE_PACKS_DIR:-}"
main_dir="$tmp_dir/main"

choose_cli

if [[ "$product" == two-pack || "$product" == four-pack || "$product" == six-pack ]]; then
  if [[ -z "${SWARMFORGE_BASE_DIR:-}" ]]; then
    download_branch "main" "$main_dir"
    host_dir="$main_dir"
  fi
  pack_src="$(pack_tree "$product")"
  if [[ -z "$pack_src" ]]; then
    pack_src="$tmp_dir/pack"
    download_branch "$product" "$pack_src"
  fi
  [[ -n "$pack_src" && -d "$pack_src" ]] || fail_missing "pack $product"
  copy_shared_scripts_and_articles "$host_dir"
  copy_pack_template "$pack_src" "."
  [[ -f swarm ]] || fail_missing "swarm from pack $product"
  chmod +x swarm
  verify_pack_roles "."
  apply_selected_cli
  require_files \
    swarm \
    swarmforge/scripts/swarmforge.sh \
    swarmforge/scripts/handoffd.bb \
    swarmforge/scripts/done_with_current.sh \
    swarmforge/constitution/articles/handoffs.prompt \
    swarmforge/constitution/articles/workflow.prompt \
    swarmforge/constitution/articles/engineering.prompt \
    swarmforge/swarmforge.conf \
    swarmforge/constitution.prompt
  installed_message "pack" "$product" "Run ./swarm to start the pack."
  exit 0
fi

if [[ -z "${SWARMFORGE_BASE_DIR:-}" ]]; then
  download_branch "$product" "$host_dir"
fi

mkdir -p projects
copy_host_files "$host_dir"

if [[ "$product" == "lieutenant" ]]; then
  install_project_pack
else
  install_named_packs
fi

apply_selected_cli

required_files=(
  swarm
  swarmforge/scripts/swarmforge.sh
  swarmforge/scripts/handoffd.bb
  swarmforge/scripts/done_with_current.sh
  swarmforge/constitution/articles/handoffs.prompt
  swarmforge/constitution/articles/workflow.prompt
  swarmforge/constitution/articles/engineering.prompt
  swarmforge/roles/lieutenant.prompt
)

if [[ "$product" == "lieutenant" ]]; then
  required_files+=(.swarmforge/project-pack/swarmforge/swarmforge.conf)
else
  required_files+=(
    packs/two-pack/swarmforge/swarmforge.conf
    packs/four-pack/swarmforge/swarmforge.conf
    packs/six-pack/swarmforge/swarmforge.conf
  )
fi

require_files "${required_files[@]}"

installed_message "forge" "$host_from" "Run ./swarm to start the dashboard."
